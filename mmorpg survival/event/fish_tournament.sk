

command /startfishingevent:
    permission: admin
    trigger:
        if {fishing.contest.active} is true:
            send "&8[<##00E3E3>FISHING CONTEST&8] &cA contest is already running!" to player
            stop
        startFishingContest(player)

function getContestPoints(fishId: text) :: integer:
    set {_rawId} to {_fishId}
    replace "fish" with "" in {_rawId}
    set {_num} to {_rawId} parsed as integer

    if {_num} <= 5:
        return 1
    else if {_num} <= 9:
        return 5
    else if {_num} <= 13:
        return 25
    else if {_num} <= 17:
        return 50
    else:
        return 100


function startFishingContest(starter: player):
    set {fishing.contest.active} to true
    set {fishing.contest.start} to now

    broadcast ""
    broadcast "&8&m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    broadcast "   <##00E3E3>&lFISHING TOURNAMENT &r&7has begun!"
    broadcast ""
    broadcast "   &7Duration: &e5 minutes"
    broadcast "&8&m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    broadcast ""

    loop all players:
        send title "<##00E3E3>&lFISHING CONTEST" with subtitle "&7Cast your line! &e{@CONTEST_DURATION} minutes" to loop-player for 3 seconds
        play sound "entity.player.levelup" at loop-player

    wait 60 seconds
    if {fishing.contest.active} is true:
        broadcast "&8[<##00E3E3>FISHING CONTEST&8] &c1 minute remaining!"
        loop all players:
            play sound "block.note_block.pling" at loop-player

    wait 50 seconds
    if {fishing.contest.active} is true:
        broadcast "&8[<##00E3E3>FISHING CONTEST&8] &c10 seconds remaining!"

    wait 10 seconds
    if {fishing.contest.active} is true:
        endFishingContest()

function endFishingContest():
    set {fishing.contest.active} to false

    delete {_scores::*}
    delete {_names::*}
    set {_count} to 0

    loop all players:
        set {_uuid} to loop-player's uuid
        set {_pts} to {fishing.contest.points::%{_uuid}%}
        if {_pts} is set:
            if {_pts} > 0:
                add 1 to {_count}
                set {_scores::%{_count}%} to {_pts}
                set {_names::%{_count}%} to "%loop-player%"


    loop {_count} times:
        set {_i} to loop-number
        set {_j} to 1
        while {_j} < ({_count} - {_i} + 1):
            set {_next} to {_j} + 1
            if {_scores::%{_j}%} < {_scores::%{_next}%}:
                set {_tmpScore} to {_scores::%{_j}%}
                set {_tmpName} to {_names::%{_j}%}
                set {_scores::%{_j}%} to {_scores::%{_next}%}
                set {_names::%{_j}%} to {_names::%{_next}%}
                set {_scores::%{_next}%} to {_tmpScore}
                set {_names::%{_next}%} to {_tmpName}
            add 1 to {_j}

    broadcast ""
    broadcast "&8&m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    broadcast "   <##00E3E3>&lFISHING TOURNAMENT &r&7— Results!"
    broadcast ""

    if {_count} is 0:
        broadcast "   &7No fish were caught. Better luck next time!"
    else:
        set {_medals::1} to "&6#1"
        set {_medals::2} to "&7#2"
        set {_medals::3} to "&c#3"

        set {_shown} to 0
        loop {_count} times:
            if loop-number <= 3:
                set {_rank} to loop-number
                set {_medal} to {_medals::%{_rank}%}
                set {_name} to {_names::%{_rank}%}
                set {_pts} to {_scores::%{_rank}%}
                set {_payout} to {_pts} * 100
                broadcast "   %{_medal}% &f%{_name}% &8— &b%{_pts}% pts &7| Total: &a$%{_payout}%&8"
                broadcast "&6&l #1 &e%{_name}% &7- &f%{_first.pts}% points"
                add 1 to {_shown}

        broadcast ""

        loop all players:
            set {_uuid} to loop-player's uuid
            set {_pts} to {fishing.contest.points::%{_uuid}%}
            if {_pts} is set:
                if {_pts} > 0:
                    set {_payout} to {_pts} * 100
                    execute console command "eco give %loop-player% %{_payout}%"
                    send "&8[<##00E3E3>FISHING CONTEST&8] &7You earned &a$%{_payout}% &7for your &b%{_pts}% points&7!" to loop-player

    broadcast "&8&m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    broadcast ""

    loop all players:
        play sound "ui.toast.challenge_complete" at loop-player


    loop all players:
        delete {fishing.contest.points::%loop-player's uuid%}
    delete {fishing.contest.active}
    delete {fishing.contest.start}

on load:
    set {fishing.contest.active} to false
    delete {fishing.contest.active}
    delete {fishing.contest.start}
    delete {_scores::*}
    delete {_names::*}
    set {_count} to 0


command /endfishingevent:
    permission: admin
    trigger:
        if {fishing.contest.active} is not true:
            send "&8[<##00E3E3>FISHING CONTEST&8] &cNo contest is currently running." to player
            stop
        send "&8[<##00E3E3>FISHING CONTEST&8] &7Ending contest early..." to player
        endFishingContest()
