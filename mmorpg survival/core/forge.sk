# Slayers
command /forgezombie:
    permission: level.15
    trigger:
        set {_slot} to 0
        loop 36 times:
            set {_item} to slot {_slot} of player's inventory
            if {_item} is not air:
                set {_nbt} to custom nbt of {_item}
                if "%{_nbt}%" contains "craft:""5""":
                    if amount of {_item} >= 64:
                        remove 64 of {_item} from player's inventory
                        execute console command "si give zombie2 1 %player% true"
                        send "&aYou forged a &eRotten Marrow&7!" to player
                        stop
                    else:
                        send "&cYou need at least 64 of this item!" to player
                        stop
            add 1 to {_slot}
        send "&cYou don't have the required Rotten &eFlesh Chunk&7!" to player

