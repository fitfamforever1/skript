command /forgemithril:
    permission: level.15
    trigger:
        set {_found} to false
        set {_slot} to 0
        loop 36 times:
            set {_item} to slot {_slot} of player's inventory
            if {_item} is not air:
                set {_nbt} to custom nbt of {_item}
                if "%{_nbt}%" contains "craft:""1""":
                    if amount of {_item} >= 16:
                        remove 16 of {_item} from player's inventory
                        execute console command "si give forge1 1 %player% true"
                        send "&aYou crafted a &eMithril Ingot&7!" to player
                        stop
                    else:
                        send "&cYou need at least 16 of this item!" to player
                        stop
            add 1 to {_slot}
        send "&cYou don't have &eMithril Ore&7!" to player

