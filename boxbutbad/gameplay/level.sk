function XPNeededForLevel(level: integer) :: integer:
    if {_level} >= 21:
        return {_level} * 1000
    if {_level} >= 11:
        return {_level} * 500
    if {_level} >= 1:
        return {_level} * 100
    return 0


function InitPlayerLevel(player: player):
    if number data tag "level:level" of {_player} is not set:
        set number data tag "level:level" of {_player} to 1
    if number data tag "level:xp" of {_player} is not set:
        set number data tag "level:xp" of {_player} to 0


function GainXP(player: player, amount: integer):
    InitPlayerLevel({_player})
    
    send action bar "&8[<#3A9424>ʟᴇᴠᴇʟɪɴɢ&8] &7ʏᴏᴜ ɢᴀɪɴᴇᴅ&b %{_amount}% xᴘ&7!" to {_player}
    
    set {_level} to number data tag "level:level" of {_player}
    set {_xp} to number data tag "level:xp" of {_player}

    if {_level} >= 30:
        stop

    if {_amount} <= 0:
        stop

    add {_amount} to {_xp}

    set {_leveling} to true
    while {_leveling} is true:
        if {_level} >= 30:
            set {_leveling} to false
            stop loop

        set {_needed} to XPNeededForLevel({_level})

        if {_needed} <= 0:
            set {_leveling} to false
            stop loop

        if {_xp} >= {_needed}:
            subtract {_needed} from {_xp}
            add 1 to {_level}

            set number data tag "level:level" of {_player} to {_level}
            set number data tag "level:xp" of {_player} to {_xp}

            if {_level} >= 30:
                set {_xp} to 0
                set number data tag "level:xp" of {_player} to 0
                send "&8[<#3A9424>ʟᴇᴠᴇʟɪɴɢ&8] &7ʏᴏᴜ ʀᴇᴀᴄʜᴇᴅ &cᴍᴀx ʟᴇᴠᴇʟ!" to {_player}
                set {_leveling} to false
                set {_player}'s max health to ({_player}'s max health) + 2
                set {_player}'s level to {_level}
                
            else:
                send "&8[<#3A9424>ʟᴇᴠᴇʟɪɴɢ&8] &7ʏᴏᴜ ᴀʀᴇ ɴᴏᴡ &bʟᴇᴠᴇʟ %{_level}%&7!" to {_player}
                set number data tag "level:xp" of {_player} to 0
                set {_player}'s max health to ({_player}'s max health) + 1
                set {_player}'s level to {_level}

        else:
            set {_leveling} to false

    set number data tag "level:xp" of {_player} to {_xp}


function GetLevel(player: player) :: integer:
    InitPlayerLevel({_player})
    set {_level} to number data tag "level:level" of {_player}
    return number data tag "level:level" of {_player}


function GetXP(player: player) :: integer:
    InitPlayerLevel({_player})
    return number data tag "level:xp" of {_player}


function GetXPToNextLevel(player: player) :: integer:
    set {_level} to GetLevel({_player})
    if {_level} >= 30:
        return 0
    set {_needed} to XPNeededForLevel({_level})
    set {_current} to GetXP({_player})
    return {_needed} - {_current}


on first join:
    InitPlayerLevel(player)
    set {_level} to number data tag "level:level" of player
    


command /gainxp <player> <integer>:
    permission: admin.xp
    trigger:
        GainXP(arg-1, arg-2)


command /level:
    trigger:
        set {_lvl} to GetLevel(player)
        if {_lvl} >= 30:
            send "&8[<#3A9424>ʟᴇᴠᴇʟɪɴɢ&8] &cᴍᴀx ʟᴇᴠᴇʟ" to player
        else:
            set {_xp} to GetXP(player)
            set {_needed} to XPNeededForLevel({_lvl})
            send "&8[<#3A9424>ʟᴇᴠᴇʟɪɴɢ&8] &7ʟᴇᴠᴇʟ: &b%{_lvl}% &8| &7xᴘ: &b%{_xp}%&7/&b%{_needed}%" to player
      
function GetMaxHealthForLevel(level: integer) :: number:
    set {_bonus} to {_level} - 1
    if {_level} >= 30:
        add 1 to {_bonus}
    return 10 + {_bonus}

command /setlevel <player> <integer>:
    permission: admin.xp
    trigger:
        if arg-2 < 1:
            send "&cLevel must be at least 1." to player
            stop
        if arg-2 > 30:
            send "&cMax level is 30." to player
            stop
        InitPlayerLevel(arg-1)
        set number data tag "level:level" of arg-1 to arg-2
        set number data tag "level:xp" of arg-1 to 0
        set {_newmax} to GetMaxHealthForLevel(arg-2)
        set arg-1's max health to {_newmax}
        set arg-1's level to arg-2
        send "&8[<#3A9424>ʟᴇᴠᴇʟɪɴɢ&8] &7ꜱᴇᴛ &b%arg-1%&7's ʟᴇᴠᴇʟ ᴛᴏ &b%arg-2%&7." to player
        send "&8[<#3A9424>ʟᴇᴠᴇʟɪɴɢ&8] &7ʏᴏᴜʀ ʟᴇᴠᴇʟ ᴡᴀꜱ ꜱᴇᴛ ᴛᴏ &b%arg-2%&7." to arg-1

command /resetlevel <player>:
    permission: admin.xp
    trigger:
        set number data tag "level:level" of arg-1 to 1
        set number data tag "level:xp" of arg-1 to 0
        set arg-1's max health to 10
        send "&8[<#3A9424>ʟᴇᴠᴇʟɪɴɢ&8] &7ʀᴇꜱᴇᴛ &b%arg-1%&7's ʟᴇᴠᴇʟ." to player
        set arg-1's level to 1
        send "&8[<#3A9424>ʟᴇᴠᴇʟɪɴɢ&8] &7ʏᴏᴜʀ ʟᴇᴠᴇʟ ʜᴀꜱ ʙᴇᴇɴ ʀᴇꜱᴇᴛ." to arg-1
      
on chat:
    cancel event
    set {_lvl} to GetLevel(player)
    if player has permission "team.owner":
        broadcast "<##e74c3c>&lᴏᴡɴᴇʀ &7%player%&7 &8[&b%{_lvl}%&8]&7: &f%message%"
    else if player has permission "team.coowner":
        broadcast "<##e67e22>&lᴄᴏ ᴏᴡɴᴇʀ &7%player%&7 &8[&b%{_lvl}%&8]&7: &f%message%"
    else if player has permission "team.manager":
        broadcast "<##9b59b6>&lᴍᴀɴᴀɢᴇʀ &7%player%&7 &8[&b%{_lvl}%&8]&7: &f%message%"
    else if player has permission "team.admin":
        broadcast "<##3498db>&lᴀᴅᴍɪɴ &7%player%&7 &8[&b%{_lvl}%&8]&7: &f%message%"
    else if player has permission "team.mod":
        broadcast "<##2ecc71>&lᴍᴏᴅ &7%player%&7 &8[&b%{_lvl}%&8]&7: &f%message%"
    else if player has permission "team.helper":
        broadcast "<##f1c40f>&lʜᴇʟᴘᴇʀ &7%player%&7 &8[&b%{_lvl}%&8]&7: &f%message%"
    else if player has permission "team.trial":
        broadcast "<##1e8449>&lᴛʀɪᴀʟ &7%player%&7 &8[&b%{_lvl}%&8]&7: &f%message%"
    else:
        broadcast "<##1abc9c>&lᴘʟᴀʏᴇʀ &7%player%&7 &8[&b%{_lvl}%&8]&7: &f%message%"