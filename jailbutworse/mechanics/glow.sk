command /glow <text> [<text>]:
    permission: admin.glow
    permission message: &cYou do not have permission to use this command.
    trigger:
        if arg-2 is set:
            set {_target} to arg-2 parsed as player
        else:
            set {_target} to player
        if arg-1 is "toggle":
            if glowing of {_target} is true:
                set glowing of {_target} to false
                execute console command "tab player %{_target}% tagprefix"
                if {_target} is not player:
            else:
                set glowing of {_target} to true
                execute console command "tab player %{_target}% tagprefix &f"
                if {_target} is not player:
        else:
            set {_c} to arg-1
            replace all " " with "_" in {_c}
            if {_c} is "red":
                set {_code} to "&c"
            else if {_c} is "blue":
                set {_code} to "&9"
            else if {_c} is "green":
                set {_code} to "&a"
            else if {_c} is "yellow":
                set {_code} to "&e"
            else if {_c} is "aqua" or "cyan":
                set {_code} to "&b"
            else if {_c} is "white":
                set {_code} to "&f"
            else if {_c} is "black":
                set {_code} to "&0"
            else if {_c} is "gray":
                set {_code} to "&7"
            else if {_c} is "dark_red":
                set {_code} to "&4"
            else if {_c} is "dark_green":
                set {_code} to "&2"
            else if {_c} is "dark_blue":
                set {_code} to "&1"
            else if {_c} is "gold" or "orange":
                set {_code} to "&6"
            else if {_c} is "light_purple" or "pink":
                set {_code} to "&d"
            else if {_c} is "purple" or "dark_purple":
                set {_code} to "&5"
            else if {_c} is "dark_gray":
                set {_code} to "&8"
            else:
                send "&cInvalid argument. Use /glow toggle [player] or /glow <color> [player]." to player
                stop
            set glowing of {_target} to true
            execute console command "tab player %{_target}% tagprefix %%luckperms_prefix%%%{_code}%"
            if {_target} is not player:
