            if {miner::ore::%{_loc}%} is set:
                stop
            set {miner::ore::%{_loc}%} to true
            cancel event
            set block at {_loc} to bedrock
            execute console command "eco give %player% 18"
            send action bar "&a+$18 &7(Gold)" to player
            wait 60 seconds
            set block at {_loc} to gold ore
            delete {miner::ore::%{_loc}%}

    if event-block is diamond ore:
        if player is holding stone pickaxe:
            set {_loc} to location of event-block
            if {miner::ore::%{_loc}%} is set:
                stop
            set {miner::ore::%{_loc}%} to true
            cancel event
            set block at {_loc} to bedrock
