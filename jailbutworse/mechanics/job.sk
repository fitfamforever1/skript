            send action bar "&a+$30 &7(Emerald)" to player
            wait 150 seconds
            set block at {_loc} to emerald ore
            delete {miner::ore::%{_loc}%}

# ===== SHOVELER =====
on mine:
    if event-block is gravel:
        if player is holding stone shovel:
            set {_loc} to location of event-block
            if {shoveler::block::%{_loc}%} is set:
                stop
            set {shoveler::block::%{_loc}%} to true
            cancel event
            set block at {_loc} to bedrock
            execute console command "eco give %player% 5"
            send action bar "&a+$5 &7(Gravel)" to player
            wait 15 seconds
            set block at {_loc} to gravel
            delete {shoveler::block::%{_loc}%}

    if event-block is coarse dirt:
        if player is holding stone shovel:
            set {_loc} to location of event-block
            if {shoveler::block::%{_loc}%} is set:
                stop
            set {shoveler::block::%{_loc}%} to true
            cancel event
            set block at {_loc} to bedrock
            execute console command "eco give %player% 8"
            send action bar "&a+$8 &7(Coarse Dirt)" to player
            wait 20 seconds
            set block at {_loc} to coarse dirt
            delete {shoveler::block::%{_loc}%}