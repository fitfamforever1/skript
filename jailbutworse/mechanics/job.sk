# ===== PLUMBING =====
on right click on iron trapdoor:
    if player is holding stick:
        cancel event
        if {plumbing::cooldown::%player%} is set:
            stop
        set {plumbing::cooldown::%player%} to true
        execute console command "eco give %player% 3"
        send action bar "&a+$3" to player
        play sound "block.iron_trapdoor.close" at player
        play sound "block.water.ambient" at player
        play sound "block.wet_sponge.place" at player
        wait 4 ticks
        delete {plumbing::cooldown::%player%}

# ===== LUMBERJACK =====
on break of jungle log:
    if player is holding stone axe:
        cancel event
        if {lumberjack::cooldown::%player%} is set:
            stop
        set {lumberjack::cooldown::%player%} to true
        set {_loc} to location of event-block
        set block at {_loc} to bedrock
        execute console command "eco give %player% 3"
        send action bar "&a+$3" to player
        wait 5 seconds
        set block at {_loc} to jungle log
        wait 80 ticks
        delete {lumberjack::cooldown::%player%}

on break of oak log:
    if player is holding stone axe:
        cancel event
        set {_loc} to location of event-block
        if {lumberjack::log::%{_loc}%} is set:
            stop
        set {lumberjack::log::%{_loc}%} to true
        set block at {_loc} to bedrock
        execute console command "eco give %player% 15"
        send action bar "&a+$15 &7(Oak Log)" to player
        wait 4 seconds
        set block at {_loc} to oak log[axis=y]
        delete {lumberjack::log::%{_loc}%}

# ===== MINER =====
on break:
    if event-block is coal ore:
        if player is holding stone pickaxe:
            set {_loc} to location of event-block
            if {miner::ore::%{_loc}%} is set:
                stop
            set {miner::ore::%{_loc}%} to true
            cancel event
            set block at {_loc} to bedrock
            execute console command "eco give %player% 5"
            send action bar "&a+$5 &7(Coal)" to player
            wait 10 seconds
            set block at {_loc} to coal ore
            delete {miner::ore::%{_loc}%}

    if event-block is iron ore:
        if player is holding stone pickaxe:
            set {_loc} to location of event-block
            if {miner::ore::%{_loc}%} is set:
                stop
            set {miner::ore::%{_loc}%} to true
            cancel event
