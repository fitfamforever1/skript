            send action bar "&a+$25 &7(Diamond)" to player
            wait 120 seconds
            set block at {_loc} to diamond ore
            delete {miner::ore::%{_loc}%}

    if event-block is emerald ore:
        if player is holding stone pickaxe:
            set {_loc} to location of event-block
            if {miner::ore::%{_loc}%} is set:
                stop
            set {miner::ore::%{_loc}%} to true
            cancel event
            set block at {_loc} to bedrock
