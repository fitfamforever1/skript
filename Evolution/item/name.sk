function hexDigit(digit: text) :: number:
    return switch return {_digit}:
        case "0" -> 0
        case "1" -> 1
        case "2" -> 2
        case "3" -> 3
        case "4" -> 4
        case "5" -> 5
        case "6" -> 6
        case "7" -> 7
        case "8" -> 8
        case "9" -> 9
        case "a" -> 10
        case "b" -> 11
        case "c" -> 12
        case "d" -> 13
        case "e" -> 14
        case "f" -> 15
        default -> 0

function applyHexColor(item: item, hex: text) :: item:
    set {_r} to (hexDigit(substring of {_hex} from 1 to 1) * 16) + hexDigit(substring of {_hex} from 2 to 2)
    set {_g} to (hexDigit(substring of {_hex} from 3 to 3) * 16) + hexDigit(substring of {_hex} from 4 to 4)
    set {_b} to (hexDigit(substring of {_hex} from 5 to 5) * 16) + hexDigit(substring of {_hex} from 6 to 6)
    send "&7[DEBUG] applyHexColor %{_hex}% -> rgb: &f%{_r}%, %{_g}%, %{_b}%" to console
    dye {_item} ({_r}, {_g}, {_b})
    return {_item}
    
    
function matname(id: number) :: text:
    return switch return {_id}:
        case 1 -> "&fCopper"
        case 2 -> "&fTin"
        case 3 -> "&fBronze"
        case 4 -> "&fIron"
        case 5 -> "&fRunesteel"
        case 6 -> "&fTitanium"
        case 7 -> "&fSunsteel"
        case 8 -> "&fCobalt"
        case 9 -> "&fStormsteel"
        case 10 -> "&fMythril"
        case 11 -> "&fOrichalcum"
        case 12 -> "&fAdamantite"
        case 13 -> "&fMidas Gold"
        case 14 -> "&fAetherium"
        case 15 -> "&fStarforged"
        case 16 -> "&fAbyssal"
        case 17 -> "&fVoidsteel"
        case 18 -> "&fEternium"