function eligible1(entity: entity):: boolean:
    if type of {_entity} is armor stand or ender dragon or experience orb or eye of ender or falling block or fireball or glow item frame or item or item frame or item display or block display or leash hitch or lightning bolt or marker or minecart or painting or splash potion or small fireball or snowball or text display or tnt or tnt minecart or trident:
        return false
    return true

function eligible2(entity: entity):: boolean:
    if type of {_entity} is zombie or husk or drowned or zombie villager or skeleton or stray or wither skeleton or bogged or creeper or spider or cave spider or slime or magma cube or phantom or witch or blaze or ghast or guardian or shulker or evoker or vindicator or pillager or ravager or hoglin or zoglin or piglin brute or breeze:
        return true
    return false
       
function assignLevel(entity: entity, p: player):
    set {_distance} to distance between location of {_entity} and location(0, 0, 0, world of {_entity})
    set {_min} to floor({_distance} / 1000) + 1

    set {_max} to number data tag "player:level" of {_p}

    if {_max} is not set:
        set {_max} to {_min}

    if {_max} < {_min}:
        set {_max} to {_min}

    set {_level} to random integer between {_min} and {_max}
    
    set number data tag "mob:level" of {_entity} to {_level}
       
function assignRank(entity: entity):
    set {_level} to number data tag "mob:level" of {_entity}
    set {_moon} to number data tag "event:moon" of world "world"

    set {_moonMult} to 1
    if {_moon} is true:
        set {_moonMult} to 2

    set {_levelMult} to 1 + ({_level} / 50)

    if {_level} >= 30:
        set {_chance} to 0.0003 * {_levelMult} * {_moonMult}
        set {_roll} to random number between 0 and 1
        if {_roll} <= {_chance}:
            set number data tag "mob:rank" of {_entity} to 5
            stop

    if {_level} >= 15:
        set {_chance} to 0.003 * {_levelMult} * {_moonMult}
        set {_roll} to random number between 0 and 1
        if {_roll} <= {_chance}:
            set number data tag "mob:rank" of {_entity} to 4
            stop

    if {_level} >= 8:
        set {_chance} to 0.015 * {_levelMult} * {_moonMult}
        set {_roll} to random number between 0 and 1
        if {_roll} <= {_chance}:
            set number data tag "mob:rank" of {_entity} to 3
            stop

    if {_level} >= 1:
        set {_chance} to 0.06 * {_levelMult} * {_moonMult}
        set {_roll} to random number between 0 and 1
        if {_roll} <= {_chance}:
            set number data tag "mob:rank" of {_entity} to 2
            stop
            
    set number data tag "mob:rank" of {_entity} to 1
       
on spawn:
    if eligible1(event-entity) is true:
        set {_p} to nearest player
        if {_p} is set:
            assignLevel(event-entity, {_p})
            if eligible2(event-entity) is true:
                assignRank(event-entity)