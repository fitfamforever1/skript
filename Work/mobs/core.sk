function eligible(entity: entity):: boolean:
    if type of {_entity} is zombie or husk or drowned or zombie villager or skeleton or stray or wither skeleton or bogged or creeper or spider or cave spider or slime or magma cube or phantom or witch or blaze or ghast or guardian or shulker or evoker or vindicator or pillager or ravager or hoglin or zoglin or piglin brute or or breeze:
        return true
    return false
         
on spawn:
    set {_distance} to distance between location of event-entity and location(0, 0, 0, world of event-entity)
    set {_level} to floor({_distance} / 1000) + 1

    set number data tag "mob:level" of event-entity to {_level}
    
command /testmoblevel:
    trigger:
        set {_entity} to targeted entity of player

        if {_entity} is not set:
            send "&cYou must be looking at an entity."
            stop

        set {_level} to number data tag "mob:level" of {_entity}
        send "&aMob level: &f%{_level}%"