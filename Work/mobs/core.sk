function eligible(entity: entity):: boolean:
    if type of {_entity} is zombie or husk or drowned or zombie villager or skeleton or stray or wither skeleton or bogged or creeper or spider or cave spider or slime or magma cube or phantom or witch or blaze or ghast or guardian or shulker or evoker or vindicator or pillager or ravager or hoglin or zoglin or piglin brute or breeze:
        return true
    return false
         
on spawn:
    set {_distance} to distance between location of event-entity and location(0, 0, 0, world of event-entity)
    set {_min} to floor({_distance} / 1000) + 1

    set {_p} to nearest player
    set {_max} to number data tag "player:level" of {_p}

    if {_max} is not set:
        set {_max} to {_min}

    if {_max} < {_min}:
        set {_max} to {_min}

    set {_level} to {_min} + floor(({_max} - {_min}) * 0.5)

    set number data tag "mob:level" of event-entity to {_level}

    broadcast "&8&m-----------------------------"
    broadcast "&eMob: &f%type of event-entity%"
    broadcast "&eDistance: &f%{_distance}%"
    broadcast "&eArea minimum: &f%{_min}%"
    broadcast "&eNearest player: &f%name of {_p}%"
    broadcast "&ePlayer level: &f%{_max}%"
    broadcast "&eFinal mob level: &a%{_level}%"
    broadcast "&8&m-----------------------------"
    
command /testmoblevel:
    trigger:
        set {_entity} to targeted entity of player

        if {_entity} is not set:
            send "&cYou must be looking at an entity."
            stop

        set {_level} to number data tag "mob:level" of {_entity}
        send "&aMob level: &f%{_level}%"
        
command /setlevel <number>:
    trigger:
        set number data tag "player:level" of player to arg-1