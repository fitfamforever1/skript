on join:
    set block break speed attribute of player to 0

function temporaryBedrock(p: player, loc: location):
    set {_id} to random integer between 1 and 1000000

    set {-tempblock::%{_p}%::%{_loc}%} to {_id}
    make {_p} see block at {_loc} as bedrock

    wait 15 seconds

    if {-tempblock::%{_p}%::%{_loc}%} is {_id}:
        delete {-tempblock::%{_p}%::%{_loc}%}
        make {_p} see block at {_loc} as original
        
on block change packet:
    if {-tempblock::%player%::%event-location%} is set:
        cancel event

on join:
    loop {-tempblock::%player%::*}:
        delete {-tempblock::%player%::%loop-index%}

function showBlockDamage(ticks: number, p: player, loc: location):
    set {_id} to random integer between 1 and 1000000

    loop {_ticks} times:
        if number data tag "mine:status" of {_p} = 0:
            make {_p} see damage of block at {_loc} as 0 from {_id}
            stop

        if targeted block of {_p} is not block at {_loc}:
            set number data tag "mine:status" of {_p} to 0
            make {_p} see damage of block at {_loc} as 0 from {_id}
            stop

        set {_damage} to loop-number / {_ticks}
        make {_p} see damage of block at {_loc} as {_damage} from {_id}
        wait 1 tick

    make {_p} see damage of block at {_loc} as 0 from {_id}
    temporaryBedrock({_p}, {_loc})


on block damage:
    set number data tag "mine:status" of player to 1

    set {_ticks} to getMiningTicks(player, target block)

    showBlockDamage({_ticks}, player, target block)


on block damage abort:
    set number data tag "mine:status" of player to 0
    
command /testbedrock:
    trigger:
        set {_block} to targeted block of player

        if {_block} is air:
            send "&cNo block targeted."
            stop

        set {_loc} to location of {_block}

        make player see {_loc} as bedrock
        send "&aSent fake bedrock at %{_loc}%!"

        wait 3 seconds

        make player see {_loc} as original
        send "&aRestored original block."