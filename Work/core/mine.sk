on join:
    set block break speed attribute of player to 0
    
function showBlockDamage(ticks: number, p: player, loc: location):
    set {_id} to random integer between 1 and 1000000

    loop {_ticks} times:
        set {_temp} to number data tag "mine:status" of {_p}

        if {_temp} = 0:
            make {_p} see damage of block at {_loc} as 0 from {_id}
            stop

        set {_origin} to eye location of {_p}
        set {_direction} to vector from yaw (yaw of {_p}) and pitch (pitch of {_p})
        set {_ray} to ray trace from {_origin} along {_direction} with max distance 5
        set {_hit} to ray trace hit block of {_ray}

        if {_hit} is not block at {_loc}:
            set number data tag "mine:status" of {_p} to 0
            make {_p} see damage of block at {_loc} as 0 from {_id}
            stop

        set {_damage} to loop-number / {_ticks}
        make {_p} see damage of block at {_loc} as {_damage} from {_id}
        wait 1 tick

    make {_p} see damage of block at {_loc} as 0 from {_id}
    
on block damage:
    set number data tag "mine:status" of player to 1
    set {_ticks} to getMiningTicks(player, target block)
    send "%{_ticks}%"
    showBlockDamage({_ticks}, player, target block)
    
on block damage abort:
    set number data tag "mine:status" of player to 0