function openScrap(p: player):
    set {gui} to chest inventory with 3 rows named "&f七七七七七七七七ㇺ"

    loop integers from 9 to 17:
        set slot loop-integer of {gui} to {itemid::46}
    
    set slot 26 of {gui} to {itemid::47}
    
    set slot 1 of {gui} to {itemid::4}
    
    open {gui} to {_p}

      
on inventory click:
    if event-inventory is {gui}:
        if click type is number key:
                cancel event
        if clicked inventory is player's inventory:
            if click type is shift+lmb, number key or shift+rmb:
                cancel event
            stop

        set {_temp} to data tag "item:id" of event-item

        if cursor slot of player is not air:
            set {_temp} to data tag "item:id" of cursor slot of player

        if event-slot is between 0 and 8:
            if {_temp} is not between 1 and 40:
                cancel event
                stop

            stop

        cancel event
      
on inventory drag:
    if event-inventory is {gui}:
        cancel event
      
command /test:
    trigger:
        openScrap(player)