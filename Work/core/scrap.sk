function openScrap(p: player):
    set {gui::%uuid of {_p}%} to chest inventory with 3 rows named "&f七七七七七七七七ㇺ"

    loop integers from 9 to 17:
        set slot loop-integer of {gui::%uuid of {_p}%} to {itemid::46}
    
    set slot 26 of {gui::%uuid of {_p}%} to {itemid::47}
    
    open {gui::%uuid of {_p}%} to {_p}
      
on inventory click:
    if player's current inventory is {gui::%uuid of player%}:
        if click type is right mouse with shift, number key or left mouse with shift:
            cancel event
    if event-inventory is {gui::%uuid of player%}:
        
        set {_gui} to {gui::%uuid of player%}
        
        set {_temp} to data tag "item:id" of event-item
        
        set data tag "cursor:id" of player to 0
        
        if cursor slot of player is not air:
            set {_temp} to data tag "item:id" of cursor slot of player
            set data tag "cursor:id" of player to 1
        
        if event-slot is between 0 and 8:
            if {_temp} is not between 1 and 40:
                cancel event
                stop
               
            wait 1 tick
            
            set {_plastic} to 0
            set {_chemical} to 0
            set {_fabric} to 0
            set {_rubber} to 0
            set {_metal} to 0
            set {_total} to 0
                
            loop integers from 0 to 8:
                set {_item} to slot loop-value of {_gui}
        
                if {_item} is air:
                    send "test" to player
                    continue
        
                set {_tag} to data tag "scrap:id" of {_item}
        
                if {_tag} is not set:
                    continue
        
                set {_stack} to amount of {_item}
        
                if {_tag} is "1":
                    add {_stack} to {_plastic}
                else if {_tag} is "2":
                    add {_stack} to {_chemical}
                else if {_tag} is "3":
                    add {_stack} to {_fabric}
                else if {_tag} is "4":
                    add {_stack} to {_rubber}
                else if {_tag} is "5":
                    add {_stack} to {_metal}
                else:
                    continue
        
                add {_stack} to {_total}
        
            send "&fPlastic: &a%{_plastic}%" to player
            send "&fChemical: &a%{_chemical}%" to player
            send "&fFabric: &a%{_fabric}%" to player
            send "&fRubber: &a%{_rubber}%" to player
            send "&fMetal: &a%{_metal}%" to player
                
            if data tag "cursor:id" of player is 1:
                send "scrap input"
                
            if data tag "cursor:id" of player is 0:
                send "scrap output"
            
            stop

        cancel event
      
on inventory drag:
    if event-inventory is {gui::%uuid of player%}:
        set {_temp} to data tag "item:id" of event-item

        if cursor slot of player is not air:
            set {_temp} to data tag "item:id" of cursor slot of player
            
        if {_temp} is between 1 and 40:
            stop
            
        cancel event
      
command /test:
    trigger:
        openScrap(player)