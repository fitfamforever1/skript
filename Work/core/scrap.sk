function openScrap(p: player):
    set {gui::%uuid of {_p}%} to chest inventory with 3 rows named "&f七七七七七七七七ㇺ"

    loop integers from 9 to 17:
        set slot loop-integer of {gui::%uuid of {_p}%} to {itemid::46}
    
    set slot 26 of {gui::%uuid of {_p}%} to {itemid::47}
    
    open {gui::%uuid of {_p}%} to {_p}
      
function scrapget(gui: inventory, accept: boolean, p: player):
    set {_plastic} to 0
    set {_chemical} to 0
    set {_fabric} to 0
    set {_rubber} to 0
    set {_metal} to 0
    set {_total} to 0

    loop integers from 0 to 8:
        set {_item} to slot loop-value of {_gui}

        if {_item} is air:
            continue

        set {_tag} to number data tag "scrap:id" of {_item}

        if {_tag} is not set:
            continue

        set {_stack} to amount of {_item}

        if {_tag} is 1:
            add {_stack} to {_plastic}
        else if {_tag} is 2:
            add {_stack} to {_chemical}
        else if {_tag} is 3:
            add {_stack} to {_fabric}
        else if {_tag} is 4:
            add {_stack} to {_rubber}
        else if {_tag} is 5:
            add {_stack} to {_metal}
        else:
            continue

        add {_stack} to {_total}
    
    scrap({_gui}, {_plastic}, {_chemical}, {_fabric}, {_rubber}, {_metal})
    
    if {_accept} is true:
        scrapgive({_p}, {_plastic}, {_chemical}, {_fabric}, {_rubber}, {_metal})
      
function scrap(gui: inventory, plastic: number, chemical: number, fabric: number, rubber: number, metal: number):
    set {_slot} to 18

    if {_plastic} > 0:
        set {_item} to {itemid::41}
        set amount of {_item} to {_plastic}
        set slot {_slot} of {_gui} to {_item}
        add 1 to {_slot}

    if {_chemical} > 0:
        set {_item} to {itemid::42}
        set amount of {_item} to {_chemical}
        set slot {_slot} of {_gui} to {_item}
        add 1 to {_slot}

    if {_fabric} > 0:
        set {_item} to {itemid::43}
        set amount of {_item} to {_fabric}
        set slot {_slot} of {_gui} to {_item}
        add 1 to {_slot}

    if {_rubber} > 0:
        set {_item} to {itemid::44}
        set amount of {_item} to {_rubber}
        set slot {_slot} of {_gui} to {_item}
        add 1 to {_slot}

    if {_metal} > 0:
        set {_item} to {itemid::45}
        set amount of {_item} to {_metal}
        set slot {_slot} of {_gui} to {_item}
        add 1 to {_slot}

    loop integers from {_slot} to 22:
        clear slot loop-value of {_gui}
      
function scrapgive(p: player, plastic: number, chemical: number, fabric: number, rubber: number, metal: number):
    if {_plastic} > 0:
        set {_item} to {loot::mat1}
        set amount of {_item} to {_plastic}
        give {_item} to {_p}

    if {_chemical} > 0:
        set {_item} to {loot::mat2}
        set amount of {_item} to {_chemical}
        give {_item} to {_p}

    if {_fabric} > 0:
        set {_item} to {loot::mat3}
        set amount of {_item} to {_fabric}
        give {_item} to {_p}

    if {_rubber} > 0:
        set {_item} to {loot::mat4}
        set amount of {_item} to {_rubber}
        give {_item} to {_p}

    if {_metal} > 0:
        set {_item} to {loot::mat5}
        set amount of {_item} to {_metal}
        give {_item} to {_p}
      
on inventory click:
    if player's current inventory is {gui::%uuid of player%}:
        if click type is right mouse with shift, number key or left mouse with shift:
            cancel event
    if event-inventory is {gui::%uuid of player%}:
    
        set {_gui} to event-inventory
        
        set {_temp} to data tag "item:id" of event-item
        
        if cursor slot of player is not air:
            set {_temp} to data tag "item:id" of cursor slot of player
        
        if event-slot is between 0 and 8:
            if {_temp} is not between 1 and 40:
                cancel event
                stop
               
            wait 1 tick
            
            scrapget({_gui}, false, player)
                
            stop
        
        if event-slot is 26:
            scrapget({_gui}, true, player)
            close player's inventory
            
        cancel event
      
on inventory drag:
    if event-inventory is {gui::%uuid of player%}:
        set {_temp} to data tag "item:id" of event-item

        if cursor slot of player is not air:
            set {_temp} to data tag "item:id" of cursor slot of player
            
        if {_temp} is between 1 and 40:
            stop
            
        cancel event
      
command /test:
    trigger:
        openScrap(player)