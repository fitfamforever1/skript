function openScrap(p: player):
    set {_gui} to chest inventory with 3 rows named "&f七七七七七七七七ㇺ"

    loop integers from 9 to 17:
        set slot loop-integer of {_gui} to {itemid::46}
    
    set slot 26 of {_gui} to {itemid::47}
    
    set slot 1 of {_gui} to {itemid::4}
    
    open {_gui} to {_p}


          
on inventory click:
    if name of event-inventory is "&f七七七七七七七七ㇺ":
        if clicked inventory is player's inventory:
            if click type is shift click:
                cancel event
            stop
            
        set {_temp} to data tag "item:id" of event-item
        if event-item is not set:
            set {_temp} to data tag "item:id" of cursor slot of player
        if {_temp} is between 1 and 45:
            if {_temp} is between 1 and 40:
                if event-slot is between 0 and 8:
                    send "scrap"
                    stop
            cancel event
            stop
        cancel event
          
command /test:
    trigger:
        openScrap(player)