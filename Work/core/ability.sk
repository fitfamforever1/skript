function getModelId(itemId: number) :: number:
    if {itemId} <= 10:
        return 1
    else if {itemId} <= 20:
        return 2
    else if {itemId} <= 30:
        return 3
    else if {itemId} <= 40:
        return 4
    else:
        return 5

function setAbilitySlot(slotIndex: number, abilityId: number) :: void:
    set {_model_id} to getModelId({abilityId})

    set {_item} to air
    set item model of {_item} to "icon/%{slotIndex}%%{_model_id}%"
    set player's inventory slot {slotIndex} to {_item}

command /slot <number> <number>:
    trigger:
        set {_slot_index} to arg-1
        set {_ability_id} to arg-2

        setAbilitySlot({_slot_index}, {_ability_id})

        send "&aSet slot %{_slot_index}% item model to: (ability %{_ability_id}%)"