# Discord-Minecraft Bridge Bot using Disky v4
# Bridges messages between Discord and Minecraft chat
# Also announces server events

# Bot Definition
define new bot named "MinecraftBridge":
    token: "MTM5OTY5NDEwMDc0MzA2NTYxMg.GGteeZ.AhSvPA5RynnFUNFmCcujwsZGuWeWw1rLdgAbPA"
    intents: default intents, message content, guild members
    policy: all
    auto reconnect: true
    compress: none
    
    on ready:
        send "%event-bot% is online!" to console
#
# Configuration
on load:
    set {discord.guild} to "1527380793356456026"
    set {discord.channel} to "1527381764534964356"
    broadcast "&6[Bridge] &aDiscord-Minecraft bridge loaded successfully"

# === MESSAGE RELAY: Discord -> Minecraft ===
on message received seen by "MinecraftBridge":
    # Check if message is from the correct guild and channel
    if event is from guild:
        if discord id of event-guild is {discord.guild} and discord id of event-channel is {discord.channel}:
            set {_author} to event-user
            set {_content} to event-message
            
            # Ignore bot messages
            if {_author} is a bot:
                stop
            
            # Ignore empty messages
            if {_content} is empty:
                stop
            
            # Relay to Minecraft
            broadcast "&b[Discord] &f%name of {_author}%&7: &f%{_content}%"

# === MESSAGE RELAY: Minecraft -> Discord ===
on chat:
    set {_player} to player
    set {_message} to message
    
    # Create Discord embed
    make embed and store it in {_embed}:
        set title of embed to "%{_player}'s display name%"
        set description of embed to {_message}
        set embed color of embed to cyan
        set footer of embed to "Minecraft Server"
        set timestamp of embed to now
    
    post {_embed} to text channel with id {discord.channel}

# === SERVER START ANNOUNCEMENT ===
on server start:
    make embed and store it in {_embed}:
        set title of embed to "🟢 Server Started"
        set description of embed to "The Minecraft server has started!"
        set embed color of embed to green
        set footer of embed to "Minecraft Server"
        set timestamp of embed to now
    
    post {_embed} to text channel with id {discord.channel}

# === SERVER STOP ANNOUNCEMENT ===
on server stop:
    make embed and store it in {_embed}:
        set title of embed to "🔴 Server Stopped"
        set description of embed to "The Minecraft server has stopped!"
        set embed color of embed to red
        set footer of embed to "Minecraft Server"
        set timestamp of embed to now
    
    post {_embed} to text channel with id {discord.channel}

# === PLAYER JOIN ANNOUNCEMENT ===
on player join:
    set {_player} to player
    
    make embed and store it in {_embed}:
        set title of embed to "➕ Player Joined"
        set description of embed to "%{_player}'s display name% has joined the server!"
        set embed color of embed to green
        set footer of embed to "Minecraft Server"
        set timestamp of embed to now
    
    post {_embed} to text channel with id {discord.channel}

# === PLAYER LEAVE ANNOUNCEMENT ===
on player quit:
    set {_player} to player
    
    make embed and store it in {_embed}:
        set title of embed to "➖ Player Left"
        set description of embed to "%{_player}'s display name% has left the server!"
        set embed color of embed to red
        set footer of embed to "Minecraft Server"
        set timestamp of embed to now
    
    post {_embed} to text channel with id {discord.channel}

# === COMMAND: Manual Server Status ===
command /serverstatus:
    description: Sends current server status to Discord
    permission: op
    trigger:
        make embed and store it in {_embed}:
            set title of embed to "📊 Server Status"
            set embed color of embed to blue
            set footer of embed to "Minecraft Server"
            set timestamp of embed to now
            set description of embed to "**Online Players: %size of all players%**"
            
            loop all players:
                add inline field named "%loop-number%" with value "%loop-value's display name%" to fields of embed
        
        post {_embed} to text channel with id {discord.channel}
        message "&6[Bridge] &aServer status sent to Discord!"