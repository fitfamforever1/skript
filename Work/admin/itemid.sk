command /itemid <text> [<number>]:
    permission: admin.save
    usage: /itemid <set/give/high/update/get/gui> [id/page]
    trigger:
        if arg-1 is "set":
            itemIDSet(player, arg-2)
        else if arg-1 is "give":
            itemIDGive(player, arg-2)
        else if arg-1 is "high":
            itemIDHigh(player)
        else if arg-1 is "update":
            itemIDUpdate(player)
        else if arg-1 is "get":
            itemIDGet(player)
        else if arg-1 is "gui":
            itemIDGUI(player, arg-2)
        else:
            send "&cUsage: /itemid <set/give/high/update/get/gui> [id/page]" to player
            
function itemIDSet(p: player, id: number):
    if {_id} is not set:
        send "&cUsage: /itemid set <id>" to {_p}
        stop

    if {_p}'s tool is air:
        send "&cYou're not holding anything!" to {_p}
        stop

    set {_item} to {_p}'s tool
    set data tag "item:id" of {_item} to {_id}
    set {loot::%{_id}%} to {_item}

    send "&aSaved held item as ID &e%{_id}%&a." to {_p}


function itemIDGive(p: player, id: number):
    if {_id} is not set:
        send "&cUsage: /itemid give <id>" to {_p}
        stop

    if {loot::%{_id}%} is not set:
        send "&cNo item found with ID &e%{_id}%&c." to {_p}
        stop

    give {loot::%{_id}%} to {_p}
    send "&aGave you item ID &e%{_id}%&a." to {_p}


function itemIDHigh(p: player):
    set {_highest} to 0

    loop {loot::*}:
        if loop-index parsed as integer > {_highest}:
            set {_highest} to loop-index parsed as integer

    send "&aHighest saved item ID: &e%{_highest}%" to {_p}


function itemIDUpdate(p: player):
    if {_p}'s tool is air:
        send "&cYou're not holding anything!" to {_p}
        stop

    set {_item} to {_p}'s tool
    set {_id} to number data tag "item:id" of {_item}

    if {_id} is not set:
        send "&cThis item doesn't have an ID!" to {_p}
        stop

    set {loot::%{_id}%} to {_item}
    send "&aUpdated item ID &e%{_id}%&a." to {_p}


function itemIDGet(p: player):
    if {_p}'s tool is air:
        send "&cYou're not holding anything!" to {_p}
        stop

    set {_id} to number data tag "item:id" of {_p}'s tool

    if {_id} is not set:
        send "&cThis item doesn't have an ID!" to {_p}
        stop

    send "&aItem ID: &e%{_id}%" to {_p}


function itemIDGUI(p: player, page: number):
    if {_page} is not set:
        set {_page} to 1

    if {_page} < 1:
        set {_page} to 1

    openItemIDGUI({_p}, {_page})
    
function openItemIDGUI(p: player, page: number):
    set {_start} to (({_page} - 1) * 45) + 1
    set {_end} to {_start} + 44

    set {_ids::*} to indices of {loot::*}
    sort {_ids::*} in ascending order

    open chest inventory with 6 rows named "&8Item Browser &7(Page %{_page}%)" to {_p}

    set {_slot} to 0
    set {_index} to 1

    loop {_ids::*}:
        if {_index} >= {_start}:
            if {_index} <= {_end}:
                set {_id} to loop-value
                set slot {_slot} of {_p}'s current inventory to {loot::%{_id}%}
                add 1 to {_slot}

        add 1 to {_index}

    set slot 45 of {_p}'s current inventory to arrow named "&ePrevious Page"
    set slot 49 of {_p}'s current inventory to barrier named "&cClose"
    set slot 53 of {_p}'s current inventory to arrow named "&eNext Page"


function handleItemIDClick(p: player, slot: number, item: item, page: number):
    if {_slot} is 45:
        if {_page} > 1:
            openItemIDGUI({_p}, {_page} - 1)
        stop

    if {_slot} is 49:
        close {_p}'s inventory
        stop

    if {_slot} is 53:
        openItemIDGUI({_p}, {_page} + 1)
        stop

    if {_item} is air:
        stop

    if click type is right mouse button:
        set {_id} to number data tag "item:id" of {_item}

        if {_id} is set:
            send "&aItem ID: &e%{_id}%" to {_p}
        else:
            send "&cThis item has no ID!" to {_p}


on inventory click:
    if name of event-inventory contains "&8Item Browser":
        cancel event

        set {_title} to uncolored name of event-inventory
        replace all "Item Browser (Page " with "" in {_title}
        replace all ")" with "" in {_title}
        set {_page} to {_title} parsed as integer

        handleItemIDClick(player, clicked slot, event-item, {_page})