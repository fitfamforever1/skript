command /modifyhelmet <text> <number>:
    permission: admin.item
    trigger:
        set {_item} to player's tool
        set player's tool to helmet({_item}, arg-1, arg-2)
    
command /modifychestplate <text> <number>:
    permission: admin.item
    trigger:
        set {_item} to player's tool
        set player's tool to chestplate({_item}, arg-1, arg-2)
    
command /modifyleggings <text> <number>:
    permission: admin.item
    trigger:
        set {_item} to player's tool
        set player's tool to leggings({_item}, arg-1, arg-2)
    
command /modifyboots <text> <number>:
    permission: admin.item
    trigger:
        set {_item} to player's tool
        set player's tool to boots({_item}, arg-1, arg-2)