command /itemid <text> [<number>]:
    permission: admin.create
    trigger:
        if arg-1 is "get":
            set {_item} to player's held item
            set {_id} to data tag "item:id" of {_item}

            if {_id} is not set:
                send "&cThis item has no ID set."
            else:
                send "&aItem ID: &e%{_id}%"

        else if arg-1 is "give":
            if arg-2 is not set:
                send "&cUsage: /itemid give <id>"
                stop

            if {itemid::%arg-2%} is set:
                give {itemid::%arg-2%} to player
                send "&aGave you item &e%arg-2%&a."
            else:
                send "&cNo item found with ID &e%arg-2%&c."

        else if arg-1 is "set":
            if arg-2 is not set:
                send "&cUsage: /itemid set <id>"
                stop
            if {itemid::%arg-2%} is set:
                send "&cAn item with ID &e%arg-2% &calready exists."
                stop
            
            set {_item} to player's held item
            set {_key} to arg-2
            set data tag "item:id" of {_item} to {_key}
            set {itemid::%{_key}%} to {_item}
            set player's held item to {_item}
            send "&aSet item ID to &e%{_key}%&a."

        else if arg-1 is "max":
            set {_highest} to -1

            loop {itemid::*}:
                if loop-index parsed as number > {_highest}:
                    set {_highest} to loop-index parsed as number

            if {_highest} < 0:
                send "&cNo items have been saved."
            else:
                send "&aHighest ID: &e%{_highest}%&a."
                
        
        else if arg-1 is "update":
            set {_item} to player's held item

            if {_item} is air:
                send "&cYou must hold an item."
                stop

            set {_id} to data tag "item:id" of {_item}

            if {_id} is not set:
                send "&cThis item has no ID set."
                stop

            if {itemid::%{_id}%} is not set:
                send "&cNo saved item found with ID &e%{_id}%&c."
                stop

            set {itemid::%{_id}%} to {_item}
            send "&aUpdated saved item with ID &e%{_id}%&a."

        else:
            send "&cUsage: /itemid <get|give|set|max|update>"
     
on tab complete of "/itemid":
    set tab completions for position 1 to "get", "give", "set", "update" and "max"
     
command /scrapset [<text>]:
    permission: admin.create
    trigger:
        set {_item} to player's held item
        set {_val} to arg-1
        set data tag "scrap:id" of {_item} to {_val}
        set player's held item to {_item}
        send "%{_val}%"
     
function getRarityLine(rarity: text) :: text:
    if {_rarity} is "trash":
        return "&8ᴛʀᴀꜱʜ "
    if {_rarity} is "common":
        return "&fᴄᴏᴍᴍᴏɴ "
    if {_rarity} is "uncommon":
        return "&aᴜɴᴄᴏᴍᴍᴏɴ "
    if {_rarity} is "rare":
        return "&9ʀᴀʀᴇ "
    if {_rarity} is "epic":
        return "&5ᴇᴘɪᴄ "
    if {_rarity} is "legendary":
        return "&6ʟᴇɢᴇɴᴅᴀʀʏ"
    if {_rarity} is "mythic":
        return "&dᴍʏᴛʜɪᴄᴀʟ "
    if {_rarity} is "special":
        return "&cꜱᴘᴇᴄɪᴀʟ "
    return ""
    
command /modifyitem [<text>] [<text>]:
    permission: admin

    trigger:
        if arg-1 is not set:
            send "&cUsage: /modifyitem <rarity> <type>"
            stop
        set {_rarity} to arg-1
        set {_type} to arg-2

        set {_rarityLine} to getRarityLine({_rarity})
        set {_typeLine} to SmallCaps({_type})

        set player's held item to unbreakable tool
        set item flags of player's tool to all item flags
        force the player's held item to stop glinting

        set line 1 of lore of player's tool to "&8┃ &7» ɪᴛᴇᴍ ɪɴғᴏ"
        set line 2 of lore of player's tool to "&8┃ &7ᴛʏᴘᴇ &8» &e%{_typeLine}%"
        set line 3 of lore of player's tool to "&8┃ &7ʀᴀʀɪᴛʏ &8» %{_rarityLine}%"

        send "&aItem modified"