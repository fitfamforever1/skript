function getRarityLine(rarity: text) :: text:
    if {_rarity} is "special":
        return "&cꜱᴘᴇᴄɪᴀʟ"
    if {_rarity} is "divine":
        return "&bᴅɪᴠɪɴᴇ"
    if {_rarity} is "mythic":
        return "&dᴍʏᴛʜɪᴄᴀʟ"
    if {_rarity} is "legendary":
        return "&6ʟᴇɢᴇɴᴅᴀʀʏ"
    if {_rarity} is "epic":
        return "&5ᴇᴘɪᴄ"
    if {_rarity} is "rare":
        return "&9ʀᴀʀᴇ"
    if {_rarity} is "uncommon":
        return "&aᴜɴᴄᴏᴍᴍᴏɴ"
    if {_rarity} is "common":
        return "&fᴄᴏᴍᴍᴏɴ"
    return ""


command /modifyitem:
    permission: admin.create
    trigger:
        if player's tool is air:
            send "&cYou must hold an item to modify."
            stop

        openItemDialog(player)


function openItemDialog(p: player):
    open new multi action dialog to {_p}:
        title: "&bItem Editor"
        external_title: "Item Editor"
        can_close_with_escape: true
        after_action: "close"
        inputs:
            add text input:
                key: "rarity"
                label: "Rarity *"
                width: 200
                max_length: 16

            add text input:
                key: "item_type"
                label: "Item Type *"
                width: 200
                max_length: 32

            add text input:
                key: "mining_speed"
                label: "Mining Speed"
                initial: "0"
                width: 200

            add text input:
                key: "mining_fortune"
                label: "Mining Fortune"
                initial: "0"
                width: 200

            add text input:
                key: "defense"
                label: "Defense"
                initial: "0"
                width: 200

            add text input:
                key: "strength"
                label: "Strength"
                initial: "0"
                width: 200

            add text input:
                key: "luck"
                label: "Luck"
                initial: "0"
                width: 200

        columns: 1
        actions:
            add callback action button:
                label: "&aSubmit"
                width: 200
                trigger:
                    set {_nbt} to event-nbt
                    set {_p} to event-player

                    set {_rarity} to string tag "rarity" of {_nbt}
                    set {_type} to string tag "item_type" of {_nbt}

                    set {_miningSpeed} to string tag "mining_speed" of {_nbt}
                    set {_miningFortune} to string tag "mining_fortune" of {_nbt}
                    set {_defense} to string tag "defense" of {_nbt}
                    set {_strength} to string tag "strength" of {_nbt}
                    set {_luck} to string tag "luck" of {_nbt}

                    if {_rarity} is "":
                        send "&cYou must enter a rarity." to {_p}
                        stop

                    if {_type} is "":
                        send "&cYou must enter an item type." to {_p}
                        stop

                    set {_item} to {_p}'s tool

                    if {_item} is air:
                        send "&cYou must hold an item to modify." to {_p}
                        stop

                    set {_item} to modifyItem({_item}, {_rarity}, {_type}, {_miningSpeed} parsed as a number, {_miningFortune} parsed as a number, {_defense} parsed as a number, {_strength} parsed as a number, {_luck} parsed as a number)

                    set {_p}'s tool to {_item}
                    send "&aSuccessfully modified your item!" to {_p}

function modifyItem(item: item, rarity: text, type: text, miningSpeed: number, miningFortune: number, defense: number, strength: number, luck: number) :: item:
    set {_item} to {_item}

    set {_rarityLine} to getRarityLine({_rarity})
    set {_typeLine} to SmallCaps({_type})

    set {_item} to unbreakable {_item}
    set item flags of {_item} to all item flags

    clear lore of {_item}

    set line 1 of lore of {_item} to "&8┃ &7» ɪᴛᴇᴍ ɪɴғᴏ"
    set line 2 of lore of {_item} to "&8┃ &7ᴛʏᴘᴇ &8» &e%{_typeLine}%"
    set line 3 of lore of {_item} to "&8┃ &7ʀᴀʀɪᴛʏ &8» %{_rarityLine}%"

    set data tag "itemstat:type" of {_item} to {_type}
    set data tag "itemstat:rarity" of {_item} to {_rarity}

    set line 4 of lore of {_item} to ""
    set line 5 of lore of {_item} to "&8┃ &7» ɪᴛᴇᴍ ꜱᴛᴀᴛꜱ"
    set {_line} to 5

    if {_miningSpeed} > 0:
        add 1 to {_line}
        set line {_line} of lore of {_item} to "&8┃ &7ᴍɪɴɪɴɢ ꜱᴘᴇᴇᴅ &8» &b+%{_miningSpeed}%"
        set number data tag "itemstat:mining_speed" of {_item} to {_miningSpeed}

    if {_miningFortune} > 0:
        add 1 to {_line}
        set line {_line} of lore of {_item} to "&8┃ &7ᴍɪɴɪɴɢ ꜰᴏʀᴛᴜɴᴇ &8» &6+%{_miningFortune}%"
        set number data tag "itemstat:mining_fortune" of {_item} to {_miningFortune}

    if {_defense} > 0:
        add 1 to {_line}
        set line {_line} of lore of {_item} to "&8┃ &7ᴅᴇғᴇɴꜱᴇ &8» &a+%{_defense}%"
        set number data tag "itemstat:defense" of {_item} to {_defense}

    if {_strength} > 0:
        add 1 to {_line}
        set line {_line} of lore of {_item} to "&8┃ &7ꜱᴛʀᴇɴɢᴛʜ &8» &c+%{_strength}%"
        set number data tag "itemstat:strength" of {_item} to {_strength}

    if {_luck} > 0:
        add 1 to {_line}
        set line {_line} of lore of {_item} to "&8┃ &7ʟᴜᴄᴋ &8» &d+%{_luck}%"
        set number data tag "itemstat:luck" of {_item} to {_luck}

    return {_item}

