
        else if arg-1 is "update":
            set {_item} to player's held item

            if {_item} is air:
                send "&cYou must hold an item."
                stop

            set {_id} to data tag "item:id" of {_item}

            if {_id} is not set:
                send "&cThis item has no ID set."
                stop

            if {itemid::%{_id}%} is not set:
                send "&cNo saved item found with ID &e%{_id}%&c."
                stop

            set {itemid::%{_id}%} to {_item}
            send "&aUpdated saved item with ID &e%{_id}%&a."

     
on tab complete of "/itemid":
    set tab completions for position 1 to "get", "give", "set", "update" and "max"
     
command /scrapset [<text>]:
    permission: admin.create
    trigger:
        set {_item} to player's held item
        set {_val} to arg-1
        set data tag "scrap:id" of {_item} to {_val}
        set player's held item to {_item}
        send "%{_val}%"
     
function getRarityLine(rarity: text) :: text:
    if {_rarity} is "trash":
        return "&8ᴛʀᴀꜱʜ "
    if {_rarity} is "common":
        return "&fᴄᴏᴍᴍᴏɴ "
    if {_rarity} is "uncommon":
        return "&aᴜɴᴄᴏᴍᴍᴏɴ "
    if {_rarity} is "rare":
        return "&9ʀᴀʀᴇ "
    if {_rarity} is "epic":
        return "&5ᴇᴘɪᴄ "
    if {_rarity} is "legendary":
        return "&6ʟᴇɢᴇɴᴅᴀʀʏ"
    if {_rarity} is "mythic":
        return "&dᴍʏᴛʜɪᴄᴀʟ "
    if {_rarity} is "special":
        return "&cꜱᴘᴇᴄɪᴀʟ "
    return ""
    
command /modifyitem [<text>] [<text>]:
    permission: admin

    trigger:
        if arg-1 is not set:
            send "&cUsage: /modifyitem <rarity> <type>"
            stop
        set {_rarity} to arg-1
        set {_type} to arg-2

        set {_rarityLine} to getRarityLine({_rarity})
        set {_typeLine} to SmallCaps({_type})

        set player's held item to unbreakable tool
        set item flags of player's tool to all item flags
        force the player's held item to stop glinting

        set line 1 of lore of player's tool to "&8┃ &7» ɪᴛᴇᴍ ɪɴғᴏ"
        set line 2 of lore of player's tool to "&8┃ &7ᴛʏᴘᴇ &8» &e%{_typeLine}%"
        set line 3 of lore of player's tool to "&8┃ &7ʀᴀʀɪᴛʏ &8» %{_rarityLine}%"

        send "&aItem modified"