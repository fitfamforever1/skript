on load:
    set {server_stats_bar} to boss bar named "server_stats"
    set bar color of {server_stats_bar} to red
    set bar style of {server_stats_bar} to solid_bar
    set bar title of {server_stats_bar} to "Initializing..."

every 1 tick:
    loop all players:
        if loop-player has permission "admin":
            set {_free_memory} to free memory
            set {_max_memory} to max memory
            set {_used_memory} to {_max_memory} - {_free_memory}
            set {_memory_percent} to ({_used_memory} / {_max_memory}) * 100 rounded to 0
            
            set {_tps} to tps
            
            set {_current_tps} to first element of {_tps} rounded to 2 decimal places
            
            if {_current_tps} >= 19.5:
                set {_tps_color} to "�a"
            else if {_current_tps} >= 15:
                set {_tps_color} to "�e"
            else:
                set {_tps_color} to "�c"
            
            if loop-player is not in {bar_players::*}:
                add loop-player to bar players of {server_stats_bar}
                add loop-player to {bar_players::*}
            
            set bar title of {server_stats_bar} to "�c[SERVER STATS] �7Memory: �f%{_used_memory}%�7/�f%{_max_memory}%MB �7(%{_memory_percent}%%) �7| �7TPS: %{_tps_color}%%{_current_tps}%"
            
            set bar progress of {server_stats_bar} to {_memory_percent}
        else:
            if loop-player is in {bar_players::*}:
                remove loop-player from bar players of {server_stats_bar}
                remove loop-player from {bar_players::*}

on join:
    if player has permission "admin":
        add player to bar players of {server_stats_bar}
        add player to {bar_players::*}

on quit:
    remove player from {bar_players::*}

command /statsbar [on|off]:
    permission: admin
    description: Toggle server stats bossbar
    trigger:
        if argument is not set or argument is "on":
            add player to bar players of {server_stats_bar}
            add player to {bar_players::*}
            send "&aServer stats bossbar enabled!"
        else:
            remove player from bar players of {server_stats_bar}
            remove player from {bar_players::*}
            send "&cServer stats bossbar disabled!"