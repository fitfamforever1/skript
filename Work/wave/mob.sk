function prog(percentage: number, length: integer) :: string:
    set {_fill} to "&a&l&m%(character at codepoint 8204)%" repeated floor(({_percentage}/100)*{_length}) times
    set {_empty} to "&8&l&m%(character at codepoint 8204)%" repeated floor((1- {_percentage}/100)*{_length}) times
    return "%{_fill}%%{_empty}%"

function mobHealth(m: entity):
    if {_m} is dead:
        stop

    set {_max} to max health of {_m}
    set {_current} to health of {_m}

    set {_percentage} to ({_current}/{_max})*100
    if {_percentage} < 2.5:
        set {_percentage} to 2.5

    set {_bar} to prog({_percentage}, 40)
    delete {_display}

    loop passengers of {_m}:
        if loop-entity is a text display:
            set {_display} to loop-entity
            stop loop

    if {_display} is not set:
        spawn text display at location of {_m}
        set {_display} to last spawned text display
        set billboard of {_display} to center
        set color of {_display} to rgb(0, 0, 0, 0)
        add {_display} to passengers of {_m}

    set text of {_display} to "&a%{_bar}%"
   
on damage:
    if victim is not a player:
        set {_mob} to victim
        if health of {_mob} - damage >= max health of {_mob}:
            stop

        wait 1 tick

        if {_mob} is dead:
            stop

        mobHealth({_mob})
        
on death:
    if victim is not player:
        loop passengers of victim:
            if loop-entity is a text display:
                kill loop-entity
   
function spawnBasic(loc: location, level: number) :: entity:
    spawn zombie at {_loc}
    set {_e} to last spawned entity

    set tool of {_e} to air
    set age of {_e} to 0

    set knockback resistance attribute of {_e} to 100
    set entity interaction range attribute of {_e} to 5
    set block interaction range attribute of {_e} to 5
    set movement speed attribute of {_e} to 0.1

    set {_health} to 100 + ({_level} - 1) * 20
    set {_damage} to 20 + ({_level} - 1) * 2

    set number data tag "mobstat:damage" of {_e} to {_damage}
    set max health of {_e} to {_health}
    set health of {_e} to {_health}

    return {_e}


function spawnElite(loc: location, level: number) :: entity:
    spawn zombie at {_loc}
    set {_e} to last spawned entity

    set tool of {_e} to air
    set age of {_e} to 0

    set knockback resistance attribute of {_e} to 100
    set entity interaction range attribute of {_e} to 5
    set block interaction range attribute of {_e} to 5
    set movement speed attribute of {_e} to 0.1

    set {_health} to 250 + ({_level} - 1) * 50
    set {_damage} to 50 + ({_level} - 1) * 4

    set number data tag "mobstat:damage" of {_e} to {_damage}
    set max health of {_e} to {_health}
    set health of {_e} to {_health}

    return {_e}
  
function spawnRandomMob(level: number):
    set {_x} to random integer between 1 and 4
    set {_loc} to location(-92, -60, 161, world("world"))

    if {_x} is 2:
        set x-coordinate of {_loc} to -93
    else if {_x} is 3:
        set x-coordinate of {_loc} to -94
    else if {_x} is 4:
        set x-coordinate of {_loc} to -95

    set {_type} to random integer between 1 and 5
    if {_type} is 1:
        spawnElite({_loc}, {_level})
    else:
        spawnBasic({_loc}, {_level})
  
command /spawnrandom <number>:
    permission: admin.mob
    trigger:
        spawnRandomMob(arg-1)
  
command /spawnmob <number>:
    permission: admin.mob
    trigger:
        set {_loc} to player's location
        spawnBasic({_loc}, arg-1)
    
command /spawnmob2 <number>:
    permission: admin.mob
    trigger:
        set {_loc} to player's location
        spawnElite({_loc}, arg-1)
    
every 1 second:
    loop all living entities:
        if loop-entity is not a player:
            set {_target} to location(-82, -63, 35)
            if distance between loop-entity and {_target} <= 2:
                broadcast "reached"
            else:
                set {_speed} to random number between 1 and 2
                make loop-entity pathfind towards {_target} at speed {_speed}
            
on pathfind:
    if the pathfinding target entity is a player:
        cancel event