function getRaceByNumber(num: number) :: text:
    return switch return {_num}:
        case 1 -> "werewolf"
        case 2 -> "vampire"
        case 3 -> "orc"
        case 4 -> "dwarf"
        case 5 -> "goblin"
        case 6 -> "merfolk"
        case 7 -> "elf"
        case 8 -> "troll"
        case 9 -> "kobold"
        case 10 -> "gnome"
        case 11 -> "kitsune"
        case 12 -> "naga"
        case 13 -> "oni"
        case 14 -> "harpy"
        case 15 -> "djinn"
        case 16 -> "minotaur"
        case 17 -> "yeti"
        case 18 -> "dryad"
        case 19 -> "phoenix"
        case 20 -> "hydra"
        case 21 -> "griffin"
        case 22 -> "kraken"
        case 23 -> "wendigo"
        case 24 -> "angel"
        case 25 -> "demon"
        case 26 -> "devil"
        case 27 -> "dragon"
        default -> "unknown"

command /racename <number>:
    trigger:
        set {_race} to getRaceByNumber(arg-1)
        send "The race corresponding to number %arg-1% is %{_race}%."