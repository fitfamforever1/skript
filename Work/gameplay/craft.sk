function craftMithril(p: player):
    if count({_p}, "6") >= 1:
        if count({_p}, "10") >= 2:
            remove({_p}, "6", 1)
            remove({_p}, "10", 2)
            give {_p} 1 of {item::mat9}
        else:
            send "&8[<##deb92b>ᴄʀᴀꜰᴛ&8] &cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ʀᴇǫᴜɪʀᴇᴅ ɪᴛᴇᴍꜱ ᴛᴏ ᴄʀᴀꜰᴛ." to {_p}
    else:
