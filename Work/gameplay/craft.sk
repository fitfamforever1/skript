function count(p: player, type: text) :: number:
    set {_count} to 0
    loop items in inventory of {_p}:
        if data tag "itemstat:mat" of loop-item is {_type}:
            add amount of loop-item to {_count}
    return {_count}

function remove(p: player, type: text, amount: integer) :: boolean:
    set {_remaining} to {_amount}
    loop items in inventory of {_p}:
        if data tag "itemstat:mat" of loop-item is {_type}:
            if amount of loop-item >= {_remaining}:
                remove {_remaining} of loop-item from inventory of {_p}
                return true
            else:
                subtract amount of loop-item from {_remaining}
                remove loop-item from inventory of {_p}
    return false

function craftSteel(p: player):
    if count({_p}, "8") >= 1:
        if count({_p}, "10") >= 3:
            remove({_p}, "8", 1)
            remove({_p}, "10", 3)
            give {_p} 1 of {item::mat5}
        else:
            send "&8[<##deb92b>ᴄʀᴀꜰᴛ&8] &cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ʀᴇǫᴜɪʀᴇᴅ ɪᴛᴇᴍꜱ ᴛᴏ ᴄʀᴀꜰᴛ." to {_p}
    else:
        send "&8[<##deb92b>ᴄʀᴀꜰᴛ&8] &cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ʀᴇǫᴜɪʀᴇᴅ ɪᴛᴇᴍꜱ ᴛᴏ ᴄʀᴀꜰᴛ." to {_p}

function craftCopper(p: player):
    if count({_p}, "3") >= 1:
        if count({_p}, "10") >= 1:
            remove({_p}, "3", 1)
            remove({_p}, "10", 1)
            give {_p} 1 of {item::mat7}
        else:
            send "&8[<##deb92b>ᴄʀᴀꜰᴛ&8] &cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ʀᴇǫᴜɪʀᴇᴅ ɪᴛᴇᴍꜱ ᴛᴏ ᴄʀᴀꜰᴛ." to {_p}
    else:
        send "&8[<##deb92b>ᴄʀᴀꜰᴛ&8] &cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ʀᴇǫᴜɪʀᴇᴅ ɪᴛᴇᴍꜱ ᴛᴏ ᴄʀᴀꜰᴛ." to {_p}
        
function craftIron(p: player):
    if count({_p}, "4") >= 1:
        if count({_p}, "10") >= 1:
            remove({_p}, "4", 1)
            remove({_p}, "10", 1)
            give {_p} 1 of {item::mat8}
        else:
            send "&8[<##deb92b>ᴄʀᴀꜰᴛ&8] &cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ʀᴇǫᴜɪʀᴇᴅ ɪᴛᴇᴍꜱ ᴛᴏ ᴄʀᴀꜰᴛ." to {_p}
    else:
        send "&8[<##deb92b>ᴄʀᴀꜰᴛ&8] &cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ʀᴇǫᴜɪʀᴇᴅ ɪᴛᴇᴍꜱ ᴛᴏ ᴄʀᴀꜰᴛ." to {_p}

function craftMithril(p: player):
    if count({_p}, "6") >= 1:
        if count({_p}, "10") >= 2:
            remove({_p}, "6", 1)
            remove({_p}, "10", 2)
            give {_p} 1 of {item::mat9}
        else:
            send "&8[<##deb92b>ᴄʀᴀꜰᴛ&8] &cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ʀᴇǫᴜɪʀᴇᴅ ɪᴛᴇᴍꜱ ᴛᴏ ᴄʀᴀꜰᴛ." to {_p}
    else:
        send "&8[<##deb92b>ᴄʀᴀꜰᴛ&8] &cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ʀᴇǫᴜɪʀᴇᴅ ɪᴛᴇᴍꜱ ᴛᴏ ᴄʀᴀꜰᴛ." to {_p}

command /teststeel:
    trigger:
        craftSteel(player)

command /testcopper:
    trigger:
        craftCopper(player)

command /testiron:
    trigger:
        craftIron(player)

command /testmithril:
    trigger:
        craftMithril(player)
