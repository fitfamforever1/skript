function spawnBasic(loc: location) :: entity:
    spawn zombie at {_loc}
    set {_e} to last spawned entity

    set tool of {_e} to air
    set age of {_e} to 0
    
    set knockback resistance attribute of {_e} to 100
    set entity interaction range attribute of {_e} to 5
    set block interaction range attribute of {_e} to 5

    set number data tag "mobstat:damage" of {_e} to 20
    set movement speed attribute of {_e} to 0.1
    set max health of {_e} to 100
    set health of {_e} to 100

    return {_e}
    
function prog(percentage: number, length: integer) :: string:
    set {_fill} to "&f&l&m%(character at codepoint 8204)%" repeated floor(({_percentage}/100)*{_length}) times
    set {_empty} to "&7&l&m%(character at codepoint 8204)%" repeated floor((1- {_percentage}/100)*{_length}) times
    return "%{_fill}%%{_empty}%"

function mobHealth(m: entity):
    set {_max} to max health of {_m}
    set {_current} to health of {_m}
    set {_percentage} to ({_current}/{_max})*100
    set {_bar} to prog({_percentage}, 100)
    set name of {_m} to "&f%{_bar}%"
   
on damage:
    if victim is not player:
        set {_mob} to victim
        wait 1 tick
        if {_mob} is dead:
            stop
        mobHealth({_mob})
   
command /spawnmob:
    trigger:
        set {_loc} to player's location
        spawnBasic({_loc})