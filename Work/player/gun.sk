function countAmmo(p: player, type: number) :: number:
    set {_count} to 0

    loop items in inventory of {_p}:
        if number data tag "ammo:id" of loop-item is {_type}:
            add amount of loop-item to {_count}

    return {_count}

function removeAmmo(p: player, type: number, amount: integer) :: boolean:
    set {_remaining} to {_amount}
    loop items in inventory of {_p}:
        if number data tag "ammo:id" of loop-item is {_type}:
            if amount of loop-item >= {_remaining}:
                remove {_remaining} of loop-item from inventory of {_p}
                return true
            else:
                subtract amount of loop-item from {_remaining}
                remove loop-item from inventory of {_p}
    return false

function ReloadGun(p: player, item: item):
    set {_id} to number data tag "gun:ammo" of {_item}
    set {_magazine} to number data tag "gun:mag" of {_item}
    set {_ammo} to number data tag "gun:mag2" of {_item}

    if {_ammo} >= {_magazine}:
        stop

    set {_reloadAmmo} to countAmmo({_p}, {_id})

    if {_reloadAmmo} <= 0:
        send title "&4&lᴏᴜᴛ ᴏꜰ ᴀᴍᴍᴏ" with subtitle "&cʏᴏᴜ ᴅᴏɴ'ᴛ ʜᴀᴠᴇ ᴇɴᴏᴜɢʜ ᴀᴍᴍᴏ!" to {_p} for 1 seconds
        stop

    set {_needed} to {_magazine} - {_ammo}

    if {_reloadAmmo} > {_needed}:
        set {_reloadAmmo} to {_needed}

    set {gun::reloading::%uuid of {_p}%} to true

    play sound "sound:sound.effect.reload" with volume 1 to {_p}
    send action bar "&eʀᴇʟᴏᴀᴅɪɴɢ..." to {_p}

    removeAmmo({_p}, {_id}, {_reloadAmmo})

    wait 68 ticks

    if {_p} is offline:
        delete {gun::reloading::%uuid of {_p}%}
        stop

    set {_item} to tool of {_p}
    set {_ammo} to data tag "gun:mag2" of {_item}
    add {_reloadAmmo} to {_ammo}
    set data tag "gun:mag2" of {_item} to {_ammo}
    set tool of {_p} to {_item}

    delete {gun::reloading::%uuid of {_p}%}
    send action bar "&aʀᴇʟᴏᴀᴅᴇᴅ!" to {_p}
    
on drop of honeycomb:
    ReloadGun(player, event-item)
    cancel event

on right click with honeycomb:
    set {_item} to player's tool

# Mag Check

    set {_mag2} to data tag "gun:mag2" of {_item}

    if {_mag2} <= 0:
        stop

# Fire Rate

    set {_speed} to data tag "gun:firerate" of {_item}
    set {_cooldown} to timespan({_speed}, ticks)

    if {gun::cooldown::%player%} is set:
        if difference between {gun::cooldown::%player%} and now is less than {_cooldown}:
            stop

    set {gun::cooldown::%player%} to now

    send "pass"