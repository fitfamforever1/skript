function reset(p: player):
    # Combat Stats
    set number data tag "playerstat:damage" of {_p} to 1
    set number data tag "playerstat:defense" of {_p} to 0
    set number data tag "playerstat:speed" of {_p} to 10
    set number data tag "playerstat:crit_chance" of {_p} to 30
    set number data tag "playerstat:crit_damage" of {_p} to 50

    # Health & Mana
    set number data tag "playerstat:health" of {_p} to 20
    set number data tag "playerstat:mana" of {_p} to 100
    set number data tag "current:health" of {_p} to 20
    set number data tag "current:mana" of {_p} to 100

    # Gathering Stats
    set number data tag "playerstat:mining_speed" of {_p} to 0
    set number data tag "playerstat:mining_fortune" of {_p} to 0
    set number data tag "playerstat:farming_fortune" of {_p} to 0
    set number data tag "playerstat:foraging_fortune" of {_p} to 0
    set number data tag "playerstat:fishing_fortune" of {_p} to 0
    set number data tag "playerstat:fishing_speed" of {_p} to 0
    
function statAdd(p: player, statName: text, amount: number):
    set {_current} to number data tag "playerstat:%{_statName}%" of {_p}
    set number data tag "playerstat:%{_statName}%" of {_p} to {_current} + {_amount}
    
function stat(p: player):
    # Combat Stats
    set {_damage} to number data tag "playerstat:damage" of {_p}
    set {_defense} to number data tag "playerstat:defense" of {_p}
    set {_speed} to number data tag "playerstat:speed" of {_p}
    set {_health} to number data tag "playerstat:health" of {_p}
    set {_mana} to number data tag "playerstat:mana" of {_p}
    set {_critChance} to number data tag "playerstat:crit_chance" of {_p}
    set {_critDamage} to number data tag "playerstat:crit_damage" of {_p}

    # Gathering Stats
    set {_miningSpeed} to number data tag "playerstat:mining_speed" of {_p}
    set {_miningFortune} to number data tag "playerstat:mining_fortune" of {_p}
    set {_farmingFortune} to number data tag "playerstat:farming_fortune" of {_p}
    set {_foragingFortune} to number data tag "playerstat:foraging_fortune" of {_p}
    set {_fishingFortune} to number data tag "playerstat:fishing_fortune" of {_p}
    set {_fishingSpeed} to number data tag "playerstat:fishing_speed" of {_p}

    # Equipment Stats
    loop helmet of {_p}, chestplate of {_p}, leggings of {_p} and boots of {_p}:
        if loop-value is not air:
            # Combat
            add number data tag "itemstat:damage" of loop-value to {_damage}
            add number data tag "itemstat:defense" of loop-value to {_defense}
            add number data tag "itemstat:speed" of loop-value to {_speed}
            add number data tag "itemstat:health" of loop-value to {_health}
            add number data tag "itemstat:mana" of loop-value to {_mana}
            add number data tag "itemstat:crit_chance" of loop-value to {_critChance}
            add number data tag "itemstat:crit_damage" of loop-value to {_critDamage}

            # Gathering
            add number data tag "itemstat:mining_speed" of loop-value to {_miningSpeed}
            add number data tag "itemstat:mining_fortune" of loop-value to {_miningFortune}
            add number data tag "itemstat:farming_fortune" of loop-value to {_farmingFortune}
            add number data tag "itemstat:foraging_fortune" of loop-value to {_foragingFortune}
            add number data tag "itemstat:fishing_fortune" of loop-value to {_fishingFortune}
            add number data tag "itemstat:fishing_speed" of loop-value to {_fishingSpeed}


    # Held Item Stats
    set {_item} to {_p}'s tool
    if {_item} is not air:
        # Combat
        add number data tag "itemstat:damage" of {_item} to {_damage}
        add number data tag "itemstat:defense" of {_item} to {_defense}
        add number data tag "itemstat:speed" of {_item} to {_speed}
        add number data tag "itemstat:health" of {_item} to {_health}
        add number data tag "itemstat:mana" of {_item} to {_mana}
        add number data tag "itemstat:crit_chance" of {_item} to {_critChance}
        add number data tag "itemstat:crit_damage" of {_item} to {_critDamage}

        # Gathering
        add number data tag "itemstat:mining_speed" of {_item} to {_miningSpeed}
        add number data tag "itemstat:mining_fortune" of {_item} to {_miningFortune}
        add number data tag "itemstat:farming_fortune" of {_item} to {_farmingFortune}
        add number data tag "itemstat:foraging_fortune" of {_item} to {_foragingFortune}
        add number data tag "itemstat:fishing_fortune" of {_item} to {_fishingFortune}
        add number data tag "itemstat:fishing_speed" of {_item} to {_fishingSpeed}


    # Apply Final Stats
    set number data tag "stat:damage" of {_p} to {_damage}
    set number data tag "stat:defense" of {_p} to {_defense}
    set number data tag "stat:speed" of {_p} to {_speed}
    set number data tag "stat:health" of {_p} to {_health}
    set number data tag "stat:mana" of {_p} to {_mana}
    set number data tag "stat:crit_chance" of {_p} to {_critChance}
    set number data tag "stat:crit_damage" of {_p} to {_critDamage}

    # Gathering
    set number data tag "stat:mining_speed" of {_p} to {_miningSpeed}
    set number data tag "stat:mining_fortune" of {_p} to {_miningFortune}
    set number data tag "stat:farming_fortune" of {_p} to {_farmingFortune}
    set number data tag "stat:foraging_fortune" of {_p} to {_foragingFortune}
    set number data tag "stat:fishing_fortune" of {_p} to {_fishingFortune}
    set number data tag "stat:fishing_speed" of {_p} to {_fishingSpeed}

    syncSpeed({_p})
    
function heal(p: player):
    set number data tag "current:mana" of {_p} to number data tag "stat:mana" of {_p}
    set number data tag "current:health" of {_p} to number data tag "stat:health" of {_p}
    
function regenPlayer(p: player):
    set {_maxHealth} to number data tag "stat:health" of {_p}
    set {_curHealth} to number data tag "current:health" of {_p}
    set {_maxMana} to number data tag "stat:mana" of {_p}
    set {_curMana} to number data tag "current:mana" of {_p}

    set {_newMana} to {_curMana} + ({_maxMana} / 20)
    if {_newMana} >= {_maxMana}:
        set {_newMana} to {_maxMana}
    set number data tag "current:mana" of {_p} to round({_newMana})

    set {_newHealth} to {_curHealth} + ({_maxHealth} / 40)
    if {_newHealth} >= {_maxHealth}:
        set {_newHealth} to {_maxHealth}
    set number data tag "current:health" of {_p} to round({_newHealth})
    
function syncSpeed(p: player):
    set {_speed} to number data tag "stat:speed" of {_p}
    set {_p}'s movement speed attribute to {_speed} / 100
    
function syncHealth(p: player):
    set {_health} to number data tag "stat:health" of {_p}
    set {_p}'s movement speed attribute to {_health}
    
function actionBar(p: player):
    set {_maxMana} to number data tag "stat:mana" of {_p}
    set {_curMana} to number data tag "current:mana" of {_p}

    send action bar "<##0096FF>%{_curMana}%&8/<##0096FF>%{_maxMana}%" to {_p}
    
every 1 second in "world":
    loop all players:
        if loop-player is alive:
            regenPlayer(loop-player)
            actionBar(loop-player)
            
command /statreset:
    trigger:
        reset(player)
        stat(player)